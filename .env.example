DISCORD_BOT_TOKEN=
# Opcional: si lo seteas, los slash commands se registran solo en ese guild (mas rapido para desarrollo).
DISCORD_GUILD_ID=

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Local: ./data/papolo.sqlite  | Docker: /data/papolo.sqlite (montado como volumen)
PAPOLO_DB_PATH=./data/papolo.sqlite
PAPOLO_WORKSPACE_ROOT=./data/workspaces

# --- Deploy: GitHub ---
# Fine-grained PAT con scopes: Contents (read+write), Administration (read+write, para crear/borrar repos).
PAPOLO_GITHUB_PAT=
# Tu username de GitHub (donde se crean los repos).
PAPOLO_GITHUB_USER=

# --- Deploy: Coolify ---
# URL base de tu instancia Coolify, sin trailing slash. Ej: https://coolify.midominio.com
COOLIFY_BASE_URL=
# Token API: Coolify UI -> Settings -> API Tokens
COOLIFY_API_TOKEN=
# UUID del server donde se crean las apps: curl -H "Authorization: Bearer $TOKEN" $COOLIFY_BASE_URL/api/v1/servers
COOLIFY_SERVER_UUID=
# UUID del proyecto "papolo-previews" (crealo manual en Coolify primero).
COOLIFY_PROJECT_UUID=
# Dominio para previews. Configurar wildcard DNS A *.preview.midominio.com -> IP del VPS.
# Las apps quedan en https://<short-uuid>.preview.midominio.com
PAPOLO_PREVIEW_DOMAIN=preview.midominio.com

# --- Deploy: MongoDB (apps con DB) ---
# Connection string del cluster Mongo compartido. Lo inyecta coolify_set_mongodb_env
# en las apps deployadas. NUNCA lo ve el modelo — se lee del env del bot.
# Cada app usa su propia DB aislada (papolo_<short-uuid>) dentro del cluster.
PAPOLO_MONGODB_URI=

# --- Tuning ---
PAPOLO_MAX_ITERS=25
PAPOLO_MAX_PARALLEL=8
PAPOLO_MAX_DEPTH=3
